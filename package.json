{
    "name": "naas-ham",
    "version": "0.1.0",
    "description": "NaaS Hardware Asset Management (x_daas_ham) - ServiceNow Fluent application",
    "license": "UNLICENSED",
    "private": true,
    "type": "module",
    "imports": {
        "#now:*": "./@types/servicenow/fluent/*/index.js"
    },
    "scripts": {
        "build": "now-sdk build",
        "build:frozen": "now-sdk build --frozenKeys",
        "deploy": "now-sdk install",
        "transform": "now-sdk transform",
        "types": "now-sdk dependencies",
        "dev": "now-sdk run dev",
        "typecheck": "tsc -p src/server/tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "eslint .",
        "check": "npm run typecheck && npm run lint && npm run test && npm run build"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.1",
        "@servicenow/glide": "27.0.5",
        "@servicenow/isomorphic-rollup": "^1.3.13",
        "@servicenow/sdk": "4.14.0",
        "@types/node": "^22.18.0",
        "@types/react": "19.x",
        "@types/react-dom": "19.x",
        "eslint": "^9.39.1",
        "globals": "^16.4.0",
        "typescript": "5.5.4",
        "typescript-eslint": "^8.46.2",
        "vitest": "^3.2.4"
    },
    "dependencies": {
        "react": "19.x",
        "react-dom": "19.x"
    }
}
