        "@tailwindcss/vite": "^4.3.5",
        "@types/node": "^22.18.0",
        "@types/react": "19.x",
        "@types/react-dom": "19.x",
        "eslint": "^9.39.1",
        "globals": "^16.4.0",
        "shadcn": "^4.23.0",
        "tailwindcss": "^4.3.5",
        "tw-animate-css": "^1.4.0",
