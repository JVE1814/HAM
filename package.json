    "type": "module",
    "scripts": {
        "build": "now-sdk build",
        "build:frozen": "now-sdk build --frozenKeys",
        "deploy": "now-sdk install",
        "transform": "now-sdk transform",
        "types": "now-sdk dependencies",
        "dev": "now-sdk run dev",
        "typecheck": "tsc -p src/server/tsconfig.json --noEmit && tsc -p src/client/tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "eslint .",
        "check": "npm run typecheck && npm run lint && npm run build && npm run test"
    },
    "devDependencies": {
