{
    "compilerOptions": {
        "moduleResolution": "bundler",
        "module": "es2022",
        "target": "es2022",
        "lib": [
            "ES2022",
            "DOM"
        ],
        "jsx": "preserve",
        "skipLibCheck": true,
        "strict": true,
        "noEmit": true,
        "allowImportingTsExtensions": true,
        "types": []
    },
    "include": [
        "./**/*.ts",
        "./**/*.tsx",
        "../server/domain/calendar.ts",
        "../server/domain/rack.ts",
        "../server/domain/rest-contracts.ts"
    ],
    "exclude": [
        "./**/*.test.ts"
    ]
}
